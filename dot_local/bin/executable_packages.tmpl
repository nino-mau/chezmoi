#!/usr/bin/env bash

set -euo pipefail

PACKAGES=()
CATEGORIES=(
    "dev"
    "essentials"
    "games"
    "gui"
    "nerd-fonts"
    "other"
    "terminal-essentials"
    "tui"
    "utils"
)

usage() {
    cat <<EOF
Usage: $(basename "$0") CATEGORY
       $(basename "$0") all [--except CATEGORY]
       $(basename "$0") list [CATEGORY|all [--except CATEGORY]]

Install a package category or every configured package.

Categories:
$(printf '  %s\n' "${CATEGORIES[@]}")
EOF
}

fail() {
    printf 'packages: %s\n' "$1" >&2
    exit 1
}

add_package() {
    local candidate="$1"
    local package

    for package in "${PACKAGES[@]}"; do
        [[ "$package" == "$candidate" ]] && return
    done

    PACKAGES+=("$candidate")
}

add_packages() {
    local package

    for package in "$@"; do
        add_package "$package"
    done
}

add_category() {
    case "$1" in
        "dev")
            add_packages "just" "mise" "docker" "docker-compose" "docker-buildx"
            ;;
        "essentials")
            add_packages "git" "noctalia" "fish" "bun" "fnm-bin" "keyd" "earlyoom" "tailscale" "greetd" "unzip" "hyprpolkitagent" "neovim-nightly-bin" "vim" "chezmoi" "tree-sitter-cli" "python" "wl-clipboard" "fd" "ripgrep" "jq" "rsync"
            ;;
        "games")
            add_packages "steam" "wine" "protonup-qt-bin" "lutris"
            ;;
        "gui")
            add_packages "mpv" "vicinae-bin" "vesktop-bin" "qbittorrent" "ghostty" "eddie-ui" "loupe" "nautilus"
            ;;
        "nerd-fonts")
            add_packages "ttf-googlesanscode-nerd" "ttf-recursive-nerd" "ttf-jetbrains-mono" "ttf-opensans" "ttf-firacode-nerd" "maplemono-nf-unhinted"
            ;;
        "other")
            add_packages "eddie-cli"
            ;;
        "terminal-essentials")
            add_packages "eza" "zoxide" "fzf" "fastfetch" "tmux" "bat" "starship" "tmuxp"
            ;;
        "tui")
            add_packages "lazygit" "lazydocker" "btop" "yazi" "pi-coding-agent" "opencode" "claude-code" "openai-codex" "gdu" "sysz"
            ;;
        "utils")
            add_packages "timg" "ie-r" "inotify-tools" "wev" "wtype" "tesseract" "codexbar-cli" "vivify"
            ;;
        *)
            return 1
            ;;
    esac
}

select_packages() {
    local selection="$1"
    local excluded="${2:-}"
    local category

    if [[ -n "$excluded" && "$selection" != "all" ]]; then
        fail "--except can only be used with all"
    fi

    if [[ "$selection" == "all" ]]; then
        if [[ -n "$excluded" && ! " ${CATEGORIES[*]} " =~ " ${excluded} " ]]; then
            fail "unknown category: $excluded"
        fi

        for category in "${CATEGORIES[@]}"; do
            [[ "$category" == "$excluded" ]] || add_category "$category"
        done
    elif ! add_category "$selection"; then
        fail "unknown category: $selection"
    fi
}

list_categories() {
    printf '%s\n' "${CATEGORIES[@]}"
}

list_packages() {
    local selection="$1"
    local excluded="${2:-}"

    select_packages "$selection" "$excluded"
    printf '%s\n' "${PACKAGES[@]}"
}

install_packages() {
    local selection="$1"
    local excluded="${2:-}"

    select_packages "$selection" "$excluded"

    if ! command -v paru >/dev/null 2>&1; then
        command -v pacman >/dev/null 2>&1 || fail "paru and pacman are not installed"
        printf 'Installing paru...\n'
        sudo pacman -S --needed paru
    fi

    printf 'Installing %d packages from %s...\n' "${#PACKAGES[@]}" "$selection"
    paru -S --needed -- "${PACKAGES[@]}"
}

main() {
    [[ $# -gt 0 ]] || { usage; exit 1; }

    case "$1" in
        -h|--help|help)
            [[ $# -eq 1 ]] || fail "help takes no arguments"
            usage
            ;;
        list)
            if [[ $# -eq 1 ]]; then
                list_categories
            elif [[ $# -eq 2 ]]; then
                list_packages "$2"
            elif [[ $# -eq 4 && "$2" == "all" && "$3" == "--except" ]]; then
                list_packages "$2" "$4"
            else
                fail "usage: $(basename "$0") list [CATEGORY|all [--except CATEGORY]]"
            fi
            ;;
        *)
            if [[ $# -eq 1 ]]; then
                install_packages "$1"
            elif [[ $# -eq 3 && "$1" == "all" && "$2" == "--except" ]]; then
                install_packages "$1" "$3"
            else
                fail "usage: $(basename "$0") all [--except CATEGORY]"
            fi
            ;;
    esac
}

main "$@"
