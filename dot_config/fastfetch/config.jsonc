{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.local/share/ascii/cat",
    "padding": {
      "top": 2
    },
    "color": {
      "1": "blue"
    }
  },
  "display": {
    "separator": "  ",
    "disableLinewrap": true,
    "brightColor": true,
    "key": {
      "type": "both-2"
    },
    "color": {
      "separator": "black",
      "title": "red",
      "keys": "blue",
      "output": "default"
    },
    "percent": {
      "color": {
        "green": "magenta",
        "yellow": "blue",
        "red": "red"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "at": "default",
        "host": "blue",
        "user": "italic_default"
      }
    },
    "break",
    {
      "type": "os",
      "format": "{pretty-name}",
      "key": "OS           ",
      "keyColor": "italic_blue"
    },
    {
      "type": "kernel",
      "key": "Kernel       ",
      "keyColor": "italic_default"
    },
    {
      "type": "wm",
      "key": "WM           ",
      "format": "{pretty-name} {version}",
      "keyColor": "italic_red",
      "outputColor": "underline_"
    },
    {
      "type": "shell",
      "format": "{pretty-name}",
      "key": "Shell        ",
      "keyColor": "italic_magenta"
    },
    {
      "type": "uptime",
      "key": "Uptime       ",
      "keyColor": "italic_yellow",
      "condition": {
        "system": "macOS"
      }
    },
    {
      "type": "gpu",
      "key": "GPU          ",
      "keyColor": "italic_yellow",
      "condition": {
        "system": "Linux"
      }
    },
    {
      "type": "memory",
      "key": "Memory       ",
      "keyColor": "italic_cyan",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": "Storage (/)  ",
      "keyColor": "italic_blue",
      "format": "{size-used} / {size-total}"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
