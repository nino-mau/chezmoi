{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.local/share/ascii/cat",
    "padding": {
      "top": 4,
      "right": 6,
      "left": 3
    },
    "color": {
      "1": "#89b4fa",
      "2": "#89b4fa"
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "title": "#b4befe",
      "keys": "#89b4fa",
      "output": "#cdd6f4"
    },
    "percent": {
      "color": {
        "green": "#cba6f7",
        "yellow": "#85b1fa",
        "red": "#f38ba8"
      }
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "keyWidth": 10
    },
    "break",
    {
      "type": "os",
      "key": " "
    },
    {
      "type": "kernel",
      "key": " "
    },
    {
      "type": "shell",
      "key": " "
    },
    {
      "type": "terminal",
      "key": " "
    },
    {
      "type": "wm",
      "key": " "
    },
    {
      "type": "disk",
      "key": "󰆼 "
    },
    {
      "type": "gpu",
      "key": "󰢮 "
    },
    {
      "type": "cpu",
      "key": "󰘚 "
    },
    {
      "type": "media",
      "key": "󰝚 "
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    },
    "break"
  ]
}
