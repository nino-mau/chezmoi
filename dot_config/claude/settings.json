{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(npm run *)",
      "Bash(bun run *)",
      "Bash(git ls *)",
      "Bash(ls*)",
      "Read(~/Code/**)",
      "Edit(~/Code/projects/**)",
      "Read(~/Code/projects/**)"
    ],
    "deny": [
      "Read(*.env)",
      "Bash(curl:*)",
      "Bash(rm *)"
    ],
    "ask": [
      "Bash(gh pr create:*)",
      "Bash(git commit:*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/claude/hooks/notify 'Ready for input'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/claude/hooks/notify 'Question requires input'"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/claude/hooks/notify 'Permission required'"
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "theme": "dark-ansi",
  "editorMode": "vim",
  "model": "opus"
}
