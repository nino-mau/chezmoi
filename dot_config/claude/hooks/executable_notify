#!/bin/sh

message=${1:?"usage: notify <message>"}

notify-send --app-name="Claude Code" "Claude Code" "$message" >/dev/null 2>&1

if [ -n "${TMUX_PANE:-}" ]; then
  pane_tty=$(tmux display-message -p -t "$TMUX_PANE" '#{pane_tty}' 2>/dev/null)
  if [ -n "$pane_tty" ]; then
    printf '\033Ptmux;\033\033]9;Claude Code: %s\007\033\\\a' "$message" >"$pane_tty"
  fi
fi

exit 0
