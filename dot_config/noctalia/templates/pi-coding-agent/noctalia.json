{
	"$schema": "https://raw.githubusercontent.com/badlogic/pi-mono/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
	"name": "noctalia",
	"vars": {
		"pink": "{{ colors.terminal_normal_magenta.default.hex }}",
		"mauve": "{{ colors.tertiary.default.hex }}",
		"red": "{{ colors.terminal_normal_red.default.hex }}",
		"yellow": "{{ colors.terminal_normal_yellow.default.hex }}",
		"green": "{{ colors.terminal_normal_green.default.hex }}",
		"cyan": "{{ colors.terminal_normal_cyan.default.hex }}",
		"blue": "{{ colors.terminal_normal_blue.default.hex }}",
		"secondary": "{{ colors.secondary.default.hex }}",
		"text": "{{ colors.on_surface.default.hex }}",
		"white": "{{ colors.terminal_normal_white.default.hex }}",
		"text_variant": "{{ colors.on_surface_variant.default.hex }}",
		"overlay": "{{ colors.outline.default.hex }}",
		"selection_bg": "{{ colors.terminal_selection_bg.default.hex }}",
		"black": "{{ colors.terminal_normal_black.default.hex }}",
		"surface": "{{ colors.surface_container.default.hex }}",
		"background": "{{ colors.terminal_background.default.hex }}",
		"shadow": "{{ colors.shadow.default.hex }}"
	},
	"colors": {
		"accent": "mauve",
		"border": "overlay",
		"borderAccent": "mauve",
		"borderMuted": "overlay",
		"success": "green",
		"error": "red",
		"warning": "yellow",
		"muted": "overlay",
		"dim": "overlay",
		"text": "text",
		"thinkingText": "text_variant",
		"selectedBg": "selection_bg",
		"userMessageBg": "surface",
		"userMessageText": "text",
		"customMessageBg": "surface",
		"customMessageText": "text",
		"customMessageLabel": "mauve",
		"toolPendingBg": "background",
		"toolSuccessBg": "background",
		"toolErrorBg": "background",
		"toolTitle": "mauve",
		"toolOutput": "white",
		"mdHeading": "blue",
		"mdLink": "secondary",
		"mdLinkUrl": "blue",
		"mdCode": "green",
		"mdCodeBlock": "text",
		"mdCodeBlockBorder": "overlay",
		"mdQuote": "pink",
		"mdQuoteBorder": "pink",
		"mdHr": "cyan",
		"mdListBullet": "cyan",
		"toolDiffAdded": "green",
		"toolDiffRemoved": "red",
		"toolDiffContext": "overlay",
		"syntaxComment": "overlay",
		"syntaxKeyword": "mauve",
		"syntaxFunction": "blue",
		"syntaxVariable": "red",
		"syntaxString": "green",
		"syntaxNumber": "yellow",
		"syntaxType": "yellow",
		"syntaxOperator": "cyan",
		"syntaxPunctuation": "overlay",
		"thinkingOff": "selection_bg",
		"thinkingMinimal": "blue",
		"thinkingLow": "blue",
		"thinkingMedium": "blue",
		"thinkingHigh": "blue",
		"thinkingXhigh": "blue",
		"bashMode": "yellow"
	},
	"export": {
		"pageBg": "shadow",
		"cardBg": "background",
		"infoBg": "surface"
	}
}
