# Environment variables

set -gx EDITOR nvim
set -gx MANPAGER "nvim +Man!"
set -gx EXB_PATH "$HOME/Code/exb"
set -gx LG_CONFIG_FILE "$HOME/.config/lazygit/config.yml,$HOME/.config/lazygit/theme.yml"
{{ if eq .chezmoi.os "darwin" -}}
set -gx XDG_CONFIG_HOME "$HOME/.config"
set -gx EZA_CONFIG_DIR "$HOME/.config/eza"
set -gx CLAUDE_CONFIG_DIR "$HOME/.config/claude"
set -gx CODEX_HOME "$HOME/.config/codex"
set -gx PI_CODING_AGENT_DIR "$HOME/.config/pi"
{{ end -}}

# Vi mode
set -g fish_key_bindings fish_vi_key_bindings
