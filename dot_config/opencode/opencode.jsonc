{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "model": "openai/gpt-5.6-luna",
  "default_agent": "plan",
  "shell": "fish",
  "permission": {
    "external_directory": "allow",
    "edit": "ask",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "rm -rf *": "deny",
      "sed *": "ask",
      "touch *": "ask"
    },
    "question": "allow"
  },
  "agent": {
    "build": {
      "mode": "primary",
      "color": "primary",
      "model": "openai/gpt-5.6-luna"
    },
    "plan": {
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "question": "allow"
      },
    },
    "full": {
      "mode": "primary",
      "color": "error",
      "permission": {
        "external_directory": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow"
      }
    },
    "chat": {
      "mode": "primary",
      "color": "secondary",
      "permission": {
        "external_directory": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny"
      }
    }
  },
}
